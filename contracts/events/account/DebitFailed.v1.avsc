{
  "type": "record",
  "name": "DebitFailed",
  "namespace": "com.bankapp.events.account.v1",
  "doc": "Event indicating that debiting funds from an account has failed.",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Unique identifier for this event."
    },
    {
      "name": "correlationId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identifier to correlate this event with a business transaction (e.g., transactionId)."
    },
    {
      "name": "accountId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "The account from which debiting failed."
    },
    {
      "name": "tryToDebitAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "The amount that was try to debited."
    },
    {
      "name": "balance",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "Balance of the account before failed try to debit."
    },
    {
      "name": "reason",
      "type": "string",
      "doc": "The reason for the failure (e.g., INSUFFICIENT_FUNDS)."
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "The timestamp when the failure occurred."
    },
    {
      "name": "headers",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Key-value map for context propagation, like tracing headers.",
      "default": {}
    }
  ]
}
