{
  "type": "record",
  "name": "FundsCredited",
  "namespace": "com.bankapp.events.account.v1",
  "doc": "Event indicating that funds have been successfully credited from an account.",
  "fields": [
    {
      "name": "eventId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Unique identifier for this event."
    },
    {
      "name": "correlationId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "Identifier to correlate this event with a business transaction (e.g., transactionId)."
    },
    {
      "name": "accountId",
      "type": {
        "type": "string",
        "logicalType": "uuid"
      },
      "doc": "The account from which funds were credited."
    },
    {
      "name": "creditedAmount",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "The amount that was credited."
    },
    {
      "name": "newBalance",
      "type": {
        "type": "bytes",
        "logicalType": "decimal",
        "precision": 19,
        "scale": 4
      },
      "doc": "The new balance of the account after the debit."
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "The timestamp when the funds were credited."
    },
    {
      "name": "headers",
      "type": {
        "type": "map",
        "values": "string"
      },
      "doc": "Key-value map for context propagation, like tracing headers.",
      "default": {}
    }
  ]
}

