{
  "type": "record",
  "name": "UserRegistered",
  "namespace": "com.bankapp.events.user.v1",
  "doc": "Event published after successful registration of a new user.",
  "fields": [
    {
      "name": "eventId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Unique identifier for this event, ensuring idempotency."
    },
    {
      "name": "userId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "The unique identifier of the registered user."
    },
    {
      "name": "email",
      "type": "string",
      "doc": "The email address of the registered user."
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "The timestamp when the user was registered (milliseconds since epoch)."
    }
  ]
}
