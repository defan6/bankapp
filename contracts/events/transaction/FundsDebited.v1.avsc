{
  "type": "record",
  "name": "FundsDebited",
  "namespace": "com.bankapp.events.account.v1",
  "doc": "Event indicating that funds have been successfully debited from an account.",
  "fields": [
    {
      "name": "eventId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Unique identifier for this event."
    },
    {
      "name": "correlationId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Identifier to correlate this event with a business transaction (e.g., transactionId)."
    },
    {
      "name": "accountId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "The account from which funds were debited."
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "The timestamp when the funds were debited."
    }
  ]
}
