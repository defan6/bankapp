{
  "type": "record",
  "name": "CreditFailed",
  "namespace": "com.bankapp.events.account.v1",
  "doc": "Event indicating that crediting funds to an account has failed.",
  "fields": [
    {
      "name": "eventId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Unique identifier for this event."
    },
    {
      "name": "correlationId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "Identifier to correlate this event with a business transaction (e.g., transactionId)."
    },
    {
      "name": "accountId",
      "type": { "type": "string", "logicalType": "uuid" },
      "doc": "The account to which crediting failed."
    },
    {
      "name": "reason",
      "type": "string",
      "doc": "The reason for the failure (e.g., ACCOUNT_CLOSED_OR_BLOCKED)."
    },
    {
      "name": "timestamp",
      "type": { "type": "long", "logicalType": "timestamp-millis" },
      "doc": "The timestamp when the failure occurred."
    }
  ]
}
